<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_result">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HASIL SCAN"
        android:textColor="@color/nc_cyan"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        android:fillViewport="true">

        <TextView
            android:id="@+id/txtScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hasil scan..."
            android:textColor="@color/nc_white"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnTranslate"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Translate"
            android:textSize="11sp"
            android:textColor="#050508"
            android:textStyle="bold"
            android:background="@drawable/bg_button_cyan" />

        <Button
            android:id="@+id/btnGemini"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="Gemini"
            android:textSize="11sp"
            android:textColor="@color/nc_white"
            android:background="@drawable/bg_button_dark" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Copy"
            android:textSize="11sp"
            android:textColor="@color/nc_white"
            android:background="@drawable/bg_button_dark" />

        <Button
            android:id="@+id/btnCross"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Tutup"
            android:textSize="11sp"
            android:textColor="@color/nc_white"
            android:background="@drawable/bg_button_pink" />
    </LinearLayout>
</LinearLayout>
