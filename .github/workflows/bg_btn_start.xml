<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0" android:startColor="#00A9BD" android:endColor="#C42070" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0" android:startColor="#00E5FF" android:endColor="#FF2E88" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
